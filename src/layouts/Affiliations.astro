---
import SectionTitle from "../components/SectionTitle.astro";
import AffiliationsText from "../components/AffiliationsText.astro";
import EducationPic from "../images/gui/education.svg";
---

<section
	class="flex flex-col p-3 gap-8 w-full max-w-[1440px] items-center self-center"
>
	<SectionTitle title="Affiliations" image={EducationPic} />
	<div class="w-full max-w-3xl grid grid-cols-1 auto-rows-fr gap-2">
		<AffiliationsText
			affiliation="UP Cinema"
			position="OIC Secretary-General"
			date="2026 - 2027"
		/>
		<AffiliationsText
			affiliation="Vision Media Productions"
			position="Associate Producer"
			date="2026 - 2027"
		/>
		<AffiliationsText
			affiliation="Piling Obrang Vidyo"
			position="Operations Head"
			date="2026"
		/>
		<AffiliationsText
			affiliation="Tinig ng Plaridel"
			position="Multimedia Staffer"
			date="2025 - Present"
		/>
		<AffiliationsText
			affiliation="Vision Media Productions"
			position="Member"
			date="2021 - Present"
		/>
		<AffiliationsText
			affiliation="DB Makati SHS Student Government"
			position="President"
			date="2024 - 2025"
		/>
		<AffiliationsText
			affiliation="DB Makati Hack Club"
			position="Founder, Co-Lead"
			date="2024 - 2025"
		/>
		<AffiliationsText
			affiliation="DB Makati JHS Student Council"
			position="President"
			date="2022 - 2023"
		/>
	</div>
</section>
